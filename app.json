{
  "expo": {
    "name": "My Fridge",
    "slug": "my-fridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myfridge.app",
      "infoPlist": {
        "NSCameraUsageDescription": "La fotocamera è usata per scattare foto agli alimenti e scansionare i codici a barre.",
        "NSPhotoLibraryUsageDescription": "Consente di scegliere una foto per l'alimento dalla libreria."
      }
    },
    "android": {
      "package": "com.myfridge.app",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "L'app usa la fotocamera per fotografare gli alimenti e scansionare i codici a barre."
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E7D32",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "57a15253-0c7e-49e0-9b47-a108f74fdebd"
      }
    }
  }
}
